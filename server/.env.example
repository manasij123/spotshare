# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://spotshare:spotshare@localhost:5432/spotshare?schema=public"

# Port the Express API listens on
PORT=4000

# Comma-separated list of origins allowed to call the API (CORS)
CLIENT_ORIGIN="http://localhost:5173"

# Public base URL used to build shareable links (e.g. https://spotshare.app)
PUBLIC_APP_URL="http://localhost:5173"

# Optional: only needed if you switch the geocoding provider away from the
# default, no-key OpenStreetMap Nominatim provider (e.g. LocationIQ, Mapbox).
# Never expose this key to the frontend - it is only read on the server.
GEOCODING_API_KEY=""

# Optional: only needed if you switch to a map tile provider that requires a
# key (e.g. MapTiler, Mapbox). The default OSM raster tiles need no key.
MAP_PROVIDER_API_KEY=""

# Nominatim requires a descriptive User-Agent/referer per its usage policy.
NOMINATIM_USER_AGENT="SpotShare/1.0 (contact@example.com)"
